{
  "name": "deluge-community-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "kill-port 4321 && pnpm run dev:companion-data & astro dev",
    "dev:companion-data": "tsx ./src/components/deluge_companion/utils/convert-md-to-json.ts --watch",
    "start": "pnpm run dev",
    "generate:pdf": "bash ./scripts/generate-pdf.sh",
    "generate:recent-changes": "node ./scripts/generate-recent-changes.mjs",
    "generate:menu-hierarchy": "node ./scripts/generate-menu-hierarchies.mjs",
    "build": "pnpm run generate:recent-changes && pnpm run generate:menu-hierarchy && tsx ./src/components/deluge_companion/utils/convert-md-to-json.ts && astro build",
    "preview": "pnpm run build && astro preview",
    "astro": "astro",
    "perf:guard": "node ./scripts/perf-guard.mjs",
    "check": "pnpm run generate:menu-hierarchy && astro check && eslint . --max-warnings=0 && prettier . --check",
    "check:fix": "prettier . --write && eslint . --fix"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^7.4.7",
    "canvas": "^3.2.0",
    "exponential-backoff": "^3.1.3",
    "fuzzysort": "^3.1.0",
    "link-preview-js": "^3.1.0",
    "marked": "^16.4.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "playwright": "1.55.1",
    "rehype-mermaid": "^3.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "remark-link-rewrite": "^1.0.7",
    "sharp": "^0.32.6",
    "starlight-blog": "^0.30.2",
    "starlight-links-validator": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0",
    "tailwindcss": "^4.1.17",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/svelte": "9.1.2",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@typescript-eslint/parser": "^8.46.4",
    "astro-eslint-parser": "^1.4.0",
    "cross-port-killer": "^1.4.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.5.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-hast": "^13.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "starlight-to-pdf": "1.4.0",
    "svelte": "5.57.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
