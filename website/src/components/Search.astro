---
import Default from "@astrojs/starlight/components/Search.astro"
---

<Default>
  <p class="message">
    Use quotation marks to search for Deluge shortcuts.
    <br />
    Example: <code>"Shift + press turn Horizontal"</code>
  </p>
</Default>

<script>
  const getSearchTarget = (scope: Element) => {
    const terms = Array.from(
      scope.querySelectorAll<HTMLElement>(".pagefind-ui__result-excerpt mark"),
    )
      .map((mark) => mark.textContent?.trim())
      .filter(Boolean)

    return terms
      .filter(
        (term, index) =>
          terms.findIndex(
            (candidate) =>
              candidate?.toLocaleLowerCase() === term?.toLocaleLowerCase(),
          ) === index,
      )
      .join(" ")
  }

  const updateSearchResultLinks = () => {
    document
      .querySelectorAll<HTMLAnchorElement>(
        "#starlight__search .pagefind-ui__result-link",
      )
      .forEach((link) => {
        const scope =
          link.closest(".pagefind-ui__result-nested") ??
          link.closest(".pagefind-ui__result")
        if (!scope) return

        const searchTarget = getSearchTarget(scope)
        if (!searchTarget) return
        const searchContext = scope
          .querySelector(".pagefind-ui__result-excerpt")
          ?.textContent?.trim()

        const url = new URL(link.href, window.location.origin)
        const section = decodeURIComponent(
          url.hash.replace(/:~:.*$/, "").replace(/^#/, ""),
        )
        url.searchParams.set("search-target", searchTarget)
        if (searchContext) {
          url.searchParams.set("search-context", searchContext)
        }
        if (section && section !== "_top") {
          url.searchParams.set("search-section", section)
        }
        link.href = `${url.pathname}${url.search}`
      })
  }

  const searchContainer = document.querySelector("#starlight__search")
  if (searchContainer) {
    new MutationObserver(updateSearchResultLinks).observe(searchContainer, {
      childList: true,
      subtree: true,
    })
    updateSearchResultLinks()
  }
</script>

<style>
  .message {
    box-sizing: content-box;
    color: var(--sl-color-gray-2);
    font-size: calc(16px * 0.8);
    padding: calc(20px * 0.8) 0;
    font-weight: 700;
    margin-top: 0;
  }

  .message code {
    font-family: var(--__sl-font-mono);
    background-color: var(--sl-color-bg-inline-code);
    margin-block: -0.125em;
    padding: 0.125em 0.375em;
  }
</style>
